# --- Database (PostgreSQL) ---
# On Vercel: add "Postgres" under the project's Storage tab and these two
# variables are created for you automatically. For local dev, point them at
# any Postgres instance (they can be the same URL locally).
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# Shop staff PIN (used to log into the shop interface)
SHOP_PIN="2229"

# Public base URL (used in QR codes and emails). On Vercel set this to your
# deployment URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Nodemailer SMTP settings (automatic client emails). Leave blank to log-only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Euromecanico Corp <admin@euromecanicocorp.com>"
