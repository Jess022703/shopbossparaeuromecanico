generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // On Vercel, add "Postgres" storage and these env vars are created
  // automatically. Locally, point them at any Postgres connection string.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// NOTE: enum-like fields are modeled as `String` and the guide `steps` field
// as a `String` of serialized JSON (kept from the original SQLite design so the
// schema stays stable across databases). The allowed values live in
// `lib/constants.ts` as TypeScript union types so the app stays type-safe.

model Vehicle {
  id        String        @id @default(cuid())
  vin       String        @unique
  plate     String?
  make      String
  model     String
  year      Int
  color     String?
  notes     String?
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  orders    RepairOrder[]
  createdAt DateTime      @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

model RepairOrder {
  id          String       @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  status      String       @default("RECEIVED") // OrderStatus
  description String
  notes       String?
  approved    Boolean      @default(false)
  lineItems   LineItem[]
  messages    MessageLog[]
  qrToken     String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model LineItem {
  id          String      @id @default(cuid())
  orderId     String
  order       RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String // LineType: LABOR | PART
  description String
  quantity    Float       @default(1)
  unitPrice   Float
  partNumber  String?
}

model MessageLog {
  id      String      @id @default(cuid())
  orderId String
  order   RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel String
  body    String
  sentAt  DateTime    @default(now())
}

model Part {
  id             String  @id @default(cuid())
  partNumber     String  @unique
  description    String
  brand          String?
  location       String?
  stock          Int     @default(0)
  unitCost       Float
  compatibleWith String?
}

model RepairGuide {
  id        String   @id @default(cuid())
  title     String
  model     String
  year      String?
  category  String
  steps     String // serialized JSON: Array<{ title, description, warning? }>
  notes     String?
  createdAt DateTime @default(now())
}
